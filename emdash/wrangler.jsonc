{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "namigroove-blog",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-emdash-site",
			"database_id": "5e94b427-1854-4691-9f84-e50e49dd7d67"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "my-emdash-media"
		}
	],
	"kv_namespaces": [
		{ "binding": "SESSION", "id": "cfaf77a2bda84a5bbb18f8c1d8081063" }
	],
	"triggers": {
		"crons": ["* * * * *"]
	}
}
