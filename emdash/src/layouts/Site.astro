---
import css from "../styles/site.css?inline";
const { title, image, desc } = Astro.props;
// 試験用の workers.dev では検索に載せない。本番ドメイン(namigroove.com)では載せる。
const host = new URL(Astro.request.url).hostname;
const noindex = host.endsWith("workers.dev") || host === "localhost";
const canonical = `https://www.namigroove.com${new URL(Astro.request.url).pathname}`;
const B = "https://www.namigroove.com"; // 本番(同一ドメイン)でも同じ値でよい
const styles = css.replaceAll('url("/fonts/', `url("${B}/fonts/`);
---
<!doctype html>
<html lang="ja"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{title}</title>
{noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={canonical}>}
<meta property="og:title" content={title}><meta property="og:type" content="article">
{image && <meta property="og:image" content={image}>}
<meta name="twitter:card" content="summary_large_image"><meta name="theme-color" content="#396cdf">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@500;700;900&family=DM+Mono:wght@400;500&display=swap">
<style is:inline set:html={styles}></style>
</head><body>
<header class="top"><div class="wrap">
<a class="logo" href={`${B}/`}><img src={`${B}/img/logo.webp?v=2`} alt="なみぐる！" width="180" height="40"></a>
<nav class="main" aria-label="メインメニュー">
<a href={`${B}/works/`} translate="no">Works</a><a href={`${B}/tools/`} translate="no">Tools</a>
<a href={`${B}/#notes`}><span class="mochi" translate="no">お知らせ</span></a>
<a href={`${B}/#links`} class="opt">リンク</a><a href={`${B}/#contact`}>依頼</a>
</nav></div></header>
<slot/>
<footer><div class="wrap foot"><a href={`${B}/`}>← トップへ戻る</a><nav class="foot-links"><a href={`${B}/privacy-policy/`}>プライバシーポリシー</a><a href={`${B}/links/`}>相互リンク</a></nav></div></footer>
</body></html>
