---
import { getEmDashCollection } from "emdash";
const { coll, title } = Astro.props;
const { entries } = await getEmDashCollection(coll);
const fmt = (d) => String(d || "").slice(0, 10).replaceAll("-", ".");
const rows = entries.map(e=>({title:e.data.title,d:String(e.data.orig_date||""),thumb:e.data.thumb,url:e.data.legacy_url||`/${coll}/${e.id}/`})).sort((a,b)=>b.d.localeCompare(a.d));
---
<main class="wrap post">
<p class="meta">NAMIGROOVE</p>
<h1>{title}</h1>
<ul class="list">{rows.map(r=><li><a href={r.url}>{r.thumb?<img src={r.thumb} alt="" loading="lazy"/>:<span class="ph"></span>}<span><time>{fmt(r.d)}</time>{r.title}</span></a></li>)}</ul>
</main>
